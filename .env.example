# Copy to .env.local for local development. Never commit real values.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_. Used for privileged writes after permission checks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional: enables AI classification, evidence reading and summaries.
# Without it the app uses deterministic templates (manual fallback).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: public URL used in sign-up confirmation emails (defaults to the Vercel URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for `npm run seed` (local use, never set in Vercel)
DEMO_PASSWORD=
